(* Symbolic model of the TDT-Pipe message-authentication core.

   Scope:
   - one registered device with a device-specific symmetric validation key;
   - one authorized telemetry topic and one unauthorized topic;
   - a public Dolev-Yao channel controlled by the attacker;
   - payload digest and HMAC protection of the protected message body.

   The model abstracts away timing, numeric sequence ordering, semantic
   plausibility, persistence, MQTT broker behavior, and DT-state storage. These
   aspects are handled by the paper's formal model and experimental evaluation.
*)

free net: channel.

free device_d: bitstring.
free topic_authorized: bitstring.
free topic_unauthorized: bitstring.

free k_d: bitstring [private].

fun digest(bitstring): bitstring.
fun protected_body(bitstring, bitstring, bitstring, bitstring, bitstring): bitstring.
fun hmac(bitstring, bitstring): bitstring.

event device_publish(bitstring, bitstring, bitstring, bitstring).
event gateway_accept(bitstring, bitstring, bitstring, bitstring).

(* The validation key of a non-compromised device must remain secret. *)
query attacker(k_d).

(* If the gateway accepts an update for a non-compromised device, then the same
   device must have published the same topic, payload, and sequence value. *)
query d: bitstring, t: bitstring, p: bitstring, s: bitstring;
      event(gateway_accept(d, t, p, s)) ==> event(device_publish(d, t, p, s)).

(* A message on an unauthorized topic must not be accepted by the gateway. *)
query d: bitstring, p: bitstring, s: bitstring;
      event(gateway_accept(d, topic_unauthorized, p, s)) ==> false.

let Device =
    !
    new payload: bitstring;
    new timestamp: bitstring;
    new sequence: bitstring;
    let payload_digest = digest(payload) in
    let body = protected_body(device_d, topic_authorized, timestamp, sequence, payload_digest) in
    let tag = hmac(k_d, body) in
    event device_publish(device_d, topic_authorized, payload, sequence);
    out(net, (device_d, topic_authorized, timestamp, sequence, payload, payload_digest, tag)).

let Gateway =
    !
    in(net, (
        claimed_device: bitstring,
        topic: bitstring,
        timestamp: bitstring,
        sequence: bitstring,
        payload: bitstring,
        received_digest: bitstring,
        received_tag: bitstring
    ));
    if claimed_device = device_d then
    if topic = topic_authorized then
    if received_digest = digest(payload) then
    if received_tag = hmac(k_d, protected_body(claimed_device, topic, timestamp, sequence, received_digest)) then
        event gateway_accept(claimed_device, topic, payload, sequence).

process
    Device | Gateway
